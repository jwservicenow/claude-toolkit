#!/usr/bin/env bash
# Pre-commit guard for jwservicenow/claude-toolkit (PUBLIC). Checks 4, 8 and 10 match the other two repos;
# 5-7 are fitted to this repo. Armed per clone with:
#     git config core.hooksPath scripts/git-hooks
# Fall back instantly (replaces the path, never additive):
#     git config --unset core.hooksPath
# Bypass a single commit, deliberately:
#     git commit --no-verify
#
# Lives at scripts/git-hooks/pre-commit, the same path it is armed from.
# Standard and rationale: git-convention.md, section 3.
#
# It serves a repo with mixed contents because every check that does not apply
# self-skips: the intake-artifact rules run only on paths under personal/projects/home/.
#
# What this guard CANNOT do, stated plainly: it does not recognise a serial
# number, and it has no idea whether a repo is public or private. It shrinks the
# blast radius of a mistake. It does not replace checking repo visibility before
# a first push.
set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Checks 1-3 (Ansible vault files) removed 2026-11-11 with Ansible; numbers not reused.

# 4. Private key material — by filename and by content.
#    The content test is anchored to the real PEM header form (five dashes, then
#    BEGIN ... PRIVATE KEY, then five dashes). Matching the bare phrase would
#    block every future edit to git-convention.md, which names these patterns in
#    prose — the exact cry-wolf failure this guard is meant to avoid.
while IFS= read -r f; do
    case "$(basename "$f")" in
        *.pub) ;;
        id_*)
            echo "BLOCKED: private key filename staged -> $f"
            echo "         Keys belong in ~/.ssh on the machine that owns them, never in a repo."
            fail=1
            ;;
    esac
    blob=$(git show ":$f" 2>/dev/null) || continue
    if printf '%s' "$blob" | grep -aqE '^-{5}BEGIN [A-Z0-9 ]+PRIVATE KEY-{5}'; then
        echo "BLOCKED: $f contains a PEM private key header."
        echo "         Remove the key material. If this is documentation showing the"
        echo "         header verbatim, that is what --no-verify is for."
        fail=1
    fi
done <<< "$staged"

# 5. Intake artifacts — the home project ONLY, scoped BY STAGED PATH.
#    Order-history exports and nameplate photos are one-time identification aids,
#    never to be committed, "even to a private repo". Scoped on purpose rather than
#    applied globally: another project may legitimately track a documentation
#    screenshot, and a blanket image block would refuse normal content. Full
#    rationale lives in git-convention.md, which is not public.
#
#    The scope is the path prefix, not remote.origin.url. One repo now spans home/,
#    homelab/ and work/, so a remote-URL test can never distinguish them and would
#    fail OPEN — silently, until the first real photo. Paths from
#    `git diff --cached --name-only` are always repo-root-relative, so the prefix
#    holds regardless of the directory the commit is run from.
while IFS= read -r f; do
    case "$f" in
        personal/projects/home/*) ;;
        *) continue ;;
    esac
    lc=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    case "$lc" in
        *.csv|*.mbox|*.jpg|*.jpeg|*.png|*.gif|*.heic|*.heif|*.webp|*.tif|*.tiff|*.bmp)
            echo "BLOCKED: intake artifact staged -> $f"
            echo "         Photos and order-history exports are identification aids only."
            echo "         Read it, record the facts in the inventory doc, leave the file out."
            fail=1
            ;;
    esac
done <<< "$staged"

# 6. Personal and work material must NEVER be committed to this public repo. Their
#    homes are the private jimww333/personal and jwservicenow/work repos.
#    Deletions are NOT blocked: `staged` is ACM-filtered, so only adding is refused.
while IFS= read -r f; do
    case "$f" in
        personal/*|work/*|projects/*|global/*)
            echo "BLOCKED: private repo path staged -> $f"
            echo "         This repo is PUBLIC. Commit it in personal or work instead."
            fail=1
            ;;
    esac
done <<< "$staged"

# 7. Force-added files: the repo's own .gitignore decides, not this hook. An
#    ignored file reaches the index only by `git add -f`, and that is what gets
#    blocked. A real exception gets a ! line in .gitignore. Additions only, so an
#    already-tracked file never cries wolf. --no-index is REQUIRED: by hook time
#    the file is in the index, and a plain check-ignore reports any staged path
#    as not-ignored. bootstrap.sh's probe is skipped so its self-test still proves
#    the PEM check above.
while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(basename "$f")" != .bootstrap-guard-probe ] || continue
    if git check-ignore -q --no-index "$f" 2>/dev/null; then
        echo "BLOCKED: file staged despite being gitignored -> $f"
        echo "         It can only have been force-added. Deliberate exception:"
        echo "         add a ! line to .gitignore."
        fail=1
    fi
done <<< "$(git diff --cached --name-only --diff-filter=A)"

# 8. Scratch strays: Claude's throwaway files belong in ~/ClaudeOS/scratch/,
#    outside every repo (global CLAUDE.md section 4, "Scratch files"). run/ is
#    deliberately not listed: llm/run/ and work run/ are real folders.
#    Additions only, so an already-tracked file never cries wolf.
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "/$f" in
        */scratch/*|*/tmp/*|*.bak|*.bak-*|*.bak.*|*.orig|*.rej|*.tmp|*~|*.swp|*/.DS_Store)
            echo "BLOCKED: scratch stray staged -> $f"
            echo "         Claude scratch goes in ~/ClaudeOS/scratch/<project>/, outside the repo."
            fail=1
            ;;
    esac
done <<< "$(git diff --cached --name-only --diff-filter=A)"

# 10. Secrets anywhere in the staged changes: gitleaks, its standard rules plus the
#     two below (git-convention.md section 3). Staged changes only, so old history
#     never blocks. Prints rule, file and line, never the value. gitleaks missing =
#     BLOCKED: a scan that silently skips looks exactly like a pass.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
IFS= read -r -d '' GITLEAKS_CONFIG_TOML <<'TOML' || true
[extend]
useDefault = true

[[rules]]
id = "bearer-header"
description = "Authorization Bearer value holding a digit"
regex = '''(?i)\bbearer\s+([A-Za-z0-9._~+/=-]{6,}[0-9][A-Za-z0-9._~+/=-]{6,})'''
entropy = 3.5
keywords = ["bearer"]

[[rules]]
id = "password-assignment"
description = "password set to a literal holding a digit or symbol"
regex = '''(?i)\b(?:passw(?:or)?d|passphrase|pwd)\b\s*(?:is|=|:|:=)\s*["'\x60]?([^\s"'\x60<>{}$]*[0-9!@#%^&+=~][^\s"'\x60<>{}$]*)'''
keywords = ["pass", "pwd"]

[[allowlists]]
description = "Doc placeholders: all-caps YOUR-... stand-ins, never real values"
regexTarget = "match"
regexes = ['''YOUR-[A-Z]+(?:-[A-Z]+)*''']
TOML
export GITLEAKS_CONFIG_TOML
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "BLOCKED: gitleaks is not installed, so staged changes cannot be checked for secrets."
    echo "         Install it first: git-convention.md section 3."
    fail=1
else
    report=$(mktemp "${TMPDIR:-/tmp}/gitleaks-precommit.XXXXXX")
    gitleaks git --pre-commit --staged --redact --no-banner --log-level error \
        --exit-code 3 --report-format json --report-path "$report" . >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq 3 ]; then
        echo "BLOCKED: possible secret in the staged changes (value hidden):"
        python3 -I -c 'import json,sys
for f in json.load(open(sys.argv[1])): print("         %s: %s line %s" % (f["RuleID"], f["File"], f["StartLine"]))' "$report" \
            || echo "         details: gitleaks git --pre-commit --staged --redact -v"
        echo "         Real secret: take it out; it stays on the host that owns it."
        echo "         False alarm: allow-list the exact path in this hook (check 10)."
        fail=1
    elif [ "$rc" -ne 0 ]; then
        echo "BLOCKED: gitleaks failed to run (exit $rc), so nothing was checked."
        fail=1
    fi
    rm -f "$report"
fi

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-commit: commit refused. Nothing was committed."
    echo "            Deliberate override, if you are certain: git commit --no-verify"
    exit 1
fi
exit 0
